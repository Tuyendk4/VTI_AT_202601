=&quot;18&quot; style=&quot;height:18px;width:18px&quot; loading=&quot;lazy&quot; decoding=&quot;async&quot;&gt;Get started - Free forever&lt;span class=&quot;transition-transform group-hover:translate-x-0.5&quot; aria-hidden=&quot;true&quot;&gt;→&lt;/span&gt;&lt;/a&gt; &lt;div class=&quot;md:hidden&quot; data-astro-cid-m2i7qt5o&gt; &lt;a data-mobile-cta=&quot;ios&quot; href=&quot;https://apps.apple.com/app/daily-dev/id6740634400&quot; data-ta=&quot;home-experiment-tour-openapp-ios&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; class=&quot;CTA cta-lav group inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-6 py-3 text-[15px] font-semibold text-white transition-all hover:bg-purple-300 hover:text-gray-900 dark:bg-white dark:text-gray-900 dark:hover:bg-purple-300&quot;&gt; Open app &lt;span class=&quot;transition-transform group-hover:translate-x-0.5&quot; aria-hidden=&quot;true&quot;&gt;→&lt;/span&gt; &lt;/a&gt; &lt;a data-mobile-cta=&quot;android&quot; href=&quot;https://play.google.com/store/apps/details?id=dev.daily&quot; data-ta=&quot;home-experiment-tour-openapp-android&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; class=&quot;CTA cta-lav group inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-6 py-3 text-[15px] font-semibold text-white transition-all hover:bg-purple-300 hover:text-gray-900 dark:bg-white dark:text-gray-900 dark:hover:bg-purple-300&quot;&gt; Open app &lt;span class=&quot;transition-transform group-hover:translate-x-0.5&quot; aria-hidden=&quot;true&quot;&gt;→&lt;/span&gt; &lt;/a&gt; &lt;/div&gt; &lt;/div&gt; &lt;/section&gt;  &lt;script&gt;
  (function () {
    const root = document.querySelector(&apos;[data-tour]&apos;);
    if (!root) return;
    const scroll = root.querySelector(&apos;[data-tour-scroll]&apos;);
    const tabs = root.querySelectorAll(&apos;[data-tour-tab]&apos;);
    const panels = root.querySelectorAll(&apos;[data-tour-panel]&apos;);
    const caption = root.querySelector(&apos;[data-tour-caption]&apos;);
    const stage = root.querySelector(&apos;[data-tour-stage]&apos;);
    const backdrop = root.querySelector(&apos;[data-tour-backdrop]&apos;);
    const backdropSquads = root.querySelector(&apos;[data-tour-backdrop-squads]&apos;);
    const backdropControl = root.querySelector(&apos;[data-tour-backdrop-control]&apos;);
    const reduce = window.matchMedia &amp;&amp; window.matchMedia(&apos;(prefers-reduced-motion: reduce)&apos;).matches;
    let capTimer = null;

    function swapCaption(text) {
      if (!caption) return;
      if (reduce) { caption.textContent = text; return; }
      caption.style.opacity = &apos;0&apos;;
      caption.style.transform = &apos;translateY(6px)&apos;;
      if (capTimer) clearTimeout(capTimer);
      capTimer = window.setTimeout(function () {
        caption.textContent = text;
        caption.style.opacity = &apos;1&apos;;
        caption.style.transform = &apos;translateY(0)&apos;;
      }, 180);
    }

    function center(tab, smooth) {
      if (!scroll || !tab) return;
      const sRect = scroll.getBoundingClientRect();
      const tRect = tab.getBoundingClientRect();
      // Absolute target scrollLeft (more reliable than a relative scrollBy).
      let target = scroll.scrollLeft + (tRect.left - sRect.left) - (scroll.clientWidth - tRect.width) / 2;
      const max = scroll.scrollWidth - scroll.clientWidth;
      target = Math.max(0, Math.min(max, target));
      scroll.scrollTo({ left: target, behavior: smooth ? &apos;smooth&apos; : &apos;auto&apos; });
    }

    function activate(tab) {
      const id = tab.getAttribute(&apos;data-tour-tab&apos;);
      for (let i = 0; i &lt; tabs.length; i++) tabs[i].setAttribute(&apos;aria-selected&apos;, String(tabs[i] === tab));
      for (let j = 0; j &lt; panels.length; j++) panels[j].hidden = panels[j].getAttribute(&apos;data-tour-panel&apos;) !== id;
      swapCaption(tab.getAttribute(&apos;data-cap&apos;));
      if (stage) {
        stage.style.setProperty(&apos;--glow-a&apos;, tab.getAttribute(&apos;data-glow-a&apos;));
        stage.style.setProperty(&apos;--glow-b&apos;, tab.getAttribute(&apos;data-glow-b&apos;));
        stage.style.setProperty(&apos;--pos-a&apos;, tab.getAttribute(&apos;data-pos-a&apos;));
        stage.style.setProperty(&apos;--pos-b&apos;, tab.getAttribute(&apos;data-pos-b&apos;));
      }
      // Cross-fade the platform backdrops: the feed image behind most tabs,
      // the Find Squads page behind Squads, the sources universe behind
      // Customize, and none behind the video default.
      if (backdrop) backdrop.style.opacity = (id === &apos;newtab&apos; || id === &apos;squads&apos; || id === &apos;control&apos;) ? &apos;0&apos; : &apos;1&apos;;
      if (backdropSquads) backdropSquads.style.opacity = (id === &apos;squads&apos;) ? &apos;1&apos; : &apos;0&apos;;
      if (backdropControl) backdropControl.style.opacity = (id === &apos;control&apos;) ? &apos;1&apos; : &apos;0&apos;;
      center(tab, true);
    }

    // ── Auto-advance (Clay-style) ───────────────────────────────────────────
    // Cycle through the tabs on a timer so the carousel demos itself. Best
    // practice (web.dev &quot;carousel best practices&quot;): dwell long enough to read
    // the caption, pause on hover, don&apos;t run off-screen, and never autoplay
    // under prefers-reduced-motion. 5s per slide matches Clay&apos;s unhurried pace.
    const AUTO_MS = 5000;
    let autoTimer = null, hovering = false, inView = false;
    function selectedIndex() {
      for (let i = 0; i &lt; tabs.length; i++) if (tabs[i].getAttribute(&apos;aria-selected&apos;) === &apos;true&apos;) return i;
      return 0;
    }
    function advance() { activate(tabs[(selectedIndex() + 1) % tabs.length]); }
    function startAuto() { if (reduce || autoTimer || !inView || hovering || tabs.length &lt; 2) return; autoTimer = window.setInterval(advance, AUTO_MS); }

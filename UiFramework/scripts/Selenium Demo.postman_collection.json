  "item": [
    {
      "name": "Selenium",
      "item": [
        {
          "name": "Create new session - Open Chrome Browser",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "let session_id = response.value.sessionId;",
                  "pm.variables.set(\"SESSION_ID\", session_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"capabilities\": {\n        \"firstMatch\": [{}],\n        \"alwaysMatch\": {\n            \"browserName\": \"chrome\"\n        }\n    }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:9515/session",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "9515",
              "path": [
                "session"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Navigate To - Navigate to Woocommerce url",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"url\": \"https://dantri.com.vn\"\n}"
            },
            "url": {
              "raw": "http://localhost:9515/session/:sessionId/url",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "9515",
              "path": [
                "session",
                ":sessionId",
                "url"
              ],
              "variable": [
                {
                  "key": "sessionId",
                  "value": "{{SESSION_ID}}",
                  "description": "(Required) "
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Find Element - Find User Name Text box",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "let element_id = response.value['element-6066-11e4-a52e-4f735466cecf'];",
                  "console.log(\"element_id: \" + element_id);",
                  "pm.variables.set(\"ELEMENT_ID\", element_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"using\": \"xpath\",\n    \"value\": \"//li[contains(@class,'has-child')]/a/span[contains(text(),'Kinh doanh')]\"\n}"
            },
            "url": {
              "raw": "http://localhost:9515/session/:sessionId/element",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "9515",
              "path": [
                "session",
                ":sessionId",
                "element"
              ],
              "variable": [
                {
                  "key": "sessionId",
                  "value": "{{SESSION_ID}}",
                  "description": "(Required) "
                }
              ]
            }
          },
          "response": []
        },
